{
  "name": "@codetelemetry/mcp",
  "version": "0.3.12",
  "description": "CodeTelemetry MCP server \u2014 lets a coding agent onboard a user end to end: authenticate (device code), obtain an ingest key, write the Claude Code OTEL config, send a test event, and confirm telemetry landed \u2014 then search, read, interpret and compare the user's own coding sessions, plan the next one, and size tasks, plans and Linear issues from that history. The plaintext key never enters the model's context.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://codetelemetry.com/docs/onboarding/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeTelemetry/codetelemetry-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CodeTelemetry/codetelemetry-mcp/issues"
  },
  "bin": {
    "codetelemetry-mcp": "./dist/src/server.js",
    "codetelemetry-connect": "./dist/src/client/bin.js",
    "mcp": "./dist/src/server.js"
  },
