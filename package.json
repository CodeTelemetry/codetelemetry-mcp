  "files": [
    "dist",
    "tool-manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run audit:source && node scripts/cleanDist.ts && tsc -p tsconfig.build.json",
    "test": "node --import ./test/support/isolateHome.ts --test --test-concurrency=4 --test-timeout=120000 test/*.test.ts test/client/*.test.ts",
    "test:protocol": "node --import ./test/support/isolateHome.ts --test test/protocol.smoke.ts",
    "test:packaged": "node --test test/packaged.smoke.ts",
    "manifest:write": "node scripts/writeManifest.ts",
    "verify:registry": "node scripts/verifyRegistry.ts",
    "audit:package": "node scripts/auditPackage.ts",
    "verify:publish-order": "node scripts/checkPublishOrder.ts",
    "smoke": "node scripts/mcpSmoke.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && node scripts/verifyRegistry.ts --source",
    "audit:source": "node scripts/auditSource.ts",
    "test:client-packaged": "node --test test/clientPackaged.smoke.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
